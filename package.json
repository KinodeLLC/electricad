{
  "name": "electricad",
  "productName": "ElectriCAD",
  "version": "0.9.4",
  "description": "The hardware IDE that can see your pins. Arduino + Raspberry Pi, live board views, native AI.",
  "main": "main/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node test/run-tests.js",
    "dist": "electron-builder --win nsis portable",
    "dist:portable": "electron-builder --win portable"
  },
  "license": "GPL-3.0-or-later",
  "devDependencies": {
    "electron": "^31.3.0",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "monaco-editor": "^0.50.0",
    "serialport": "^12.0.0"
  },
  "author": "Kinode LLC",
  "build": {
    "appId": "local.electricad.ide",
    "productName": "ElectriCAD",
    "copyright": "ElectriCAD",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "main/**",
      "renderer/**",
      "assets/**",
      "library/**",
      "docs/**",
      "README.md",
      "package.json",
      "!**/*.map"
    ],
    "asar": false,
    "npmRebuild": false,
    "electronDist": "node_modules/electron/dist",
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/electricad.ico",
      "artifactName": "${productName}-${version}-${arch}-${target}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "ElectriCAD",
      "installerIcon": "assets/electricad.ico",
      "uninstallerIcon": "assets/electricad.ico",
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.${ext}"
    }
  },
  "homepage": "https://usekinode.app/products/electricad",
  "repository": {
    "type": "git",
    "url": "https://github.com/KinodeLLC/electricad.git"
  }
}
